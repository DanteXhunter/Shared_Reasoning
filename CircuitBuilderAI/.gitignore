# ============================================
#  .gitignore — Proyecto CircuitBuilderAI
#  Aplica a esta carpeta y todas sus subcarpetas
#  (Frontend en Node + Backend en Python/FastAPI)
# ============================================

# --------------------------------------------
#  Claude / documentación interna (no subir)
# --------------------------------------------
CLAUDE.md
**/CLAUDE.md
.claude/

# --------------------------------------------
#  Variables de entorno y secretos (¡NUNCA subir!)
# --------------------------------------------
.env
.env.*
# sí permitimos subir el ejemplo plantilla
!.env.example

# ============================================
#  FRONTEND (Node / JavaScript / TypeScript)
# ============================================

# Dependencias instaladas
node_modules/

# Builds y salidas de compilación
dist/
build/
.next/
out/

# Caché de herramientas
.cache/
.vite/
.turbo/

# Logs de npm / yarn / pnpm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ============================================
#  BACKEND (Python / FastAPI)
# ============================================

# Bytecode y caché de Python
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
.venv/
env/
ENV/

# Distribución / empaquetado
*.egg-info/
.eggs/
*.egg

# Pruebas y cobertura
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Base de datos local (SQLite)
*.sqlite3
*.db

# ============================================
#  Sistema operativo / Editores
# ============================================
# macOS
.DS_Store
# Windows
Thumbs.db
# JetBrains (PyCharm, WebStorm)
.idea/
# VS Code (quita esta línea si quieres compartir config)
.vscode/

# ============================================
#  Logs generales
# ============================================
*.log
