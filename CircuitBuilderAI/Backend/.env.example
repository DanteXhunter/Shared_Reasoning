# ============================================
#  Plantilla de variables de entorno — BACKEND
#  Copia este archivo como ".env" y rellena los valores.
#    cp .env.example .env
#  El archivo .env real NUNCA se sube a Git (tiene secretos).
# ============================================

# --- Claves de API de cada proveedor MLLM ---
# Gemini: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# NVIDIA (API compatible con OpenAI): https://build.nvidia.com
NVIDIA_API_KEY=

# --- Ollama (modelo local, opcional — ver CLAUDE.md §7.2) ---
# Solo aplica si corres Ollama en la misma máquina que el backend. Ninguna
# de las dos tiene que estar seteada: si se omiten, el catálogo usa estos
# mismos valores por default.
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Default real del código es "llava"; el modelo con el que de hecho se probó
# (qwen2.5vl, 48.5s/imagen y JSON inválido en el primer intento — descalificante
# para uso interactivo) hay que setearlo explícito si se quiere reproducir:
# OLLAMA_MODEL=qwen2.5vl

# --- Base de datos (PostgreSQL / Supabase) ---
# Usar SIEMPRE el "Session pooler" (Project Settings → Database → Connect →
# pestaña "Session pooler"), NUNCA la "Direct connection".
# La conexión directa (db.<ref>.supabase.co) solo resuelve por IPv6 desde 2024;
# en redes IPv4-only (ej. redes universitarias/corporativas) es inalcanzable y
# el backend falla con 500 en /auth/* (se ve como "Failed to fetch" en el navegador).
# El pooler (host con "pooler.supabase.com") sí tiene IPv4 y funciona en cualquier red.
DATABASE_URL=

# --- Autenticación (JWT) ---
# Secreto para firmar los tokens. Genéralo con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
# Vida del token en minutos (por defecto 7 días = 10080).
JWT_EXPIRA_MINUTOS=10080

# --- API keys propias del usuario (cifradas en BD) ---
# Llave simétrica (Fernet) que cifra/descifra las API keys que cada usuario
# guarda en Mi cuenta → API keys propias. Si se pierde esta llave, esas keys
# guardadas quedan irrecuperables (no hay backdoor) — cada usuario tendría que
# volver a ingresarlas. Genérala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEYS_SECRET=

# --- Biblioteca de esquemáticos de ejemplo (Supabase Storage) ---
# Project Settings → API → "Publishable key" (NUNCA la "Secret key" — esa da
# acceso privilegiado y no debe salir del dashboard). Sin estas dos, el
# endpoint /biblioteca-esquematicos simplemente devuelve todo vacío en vez
# de fallar — no bloquean el resto de la app si se omiten.
SUPABASE_URL=
SUPABASE_ANON_KEY=
