# ============================================
#  Plantilla de variables de entorno — FRONTEND (Vite)
#  Copia este archivo como ".env" y rellena los valores.
#    cp .env.example .env
#
#  ⚠️ IMPORTANTE (Vite):
#  - Las variables DEBEN empezar con el prefijo VITE_ para que el
#    frontend pueda leerlas; si no, Vite las ignora.
#  - Todo lo que pongas aquí queda EXPUESTO en el navegador.
#    NUNCA pongas claves secretas (API keys de Gemini, etc.) en el
#    frontend. Los secretos viven solo en el backend.
# ============================================

# URL base del backend FastAPI al que llama el frontend.
# En desarrollo, el backend corre en el puerto 8000.
VITE_API_URL=http://localhost:8000
